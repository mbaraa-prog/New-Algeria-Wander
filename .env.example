# Django Core
# This example is intended for local development.
DJANGO_SECRET_KEY=your-very-secret-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# For production with PostgreSQL (recommended):
# DATABASE_URL=postgresql://user:password@host:5432/database_name

# For local development with SQLite (default):
# Leave DATABASE_URL empty to use SQLite via dj_database_url default.

# For MySQL database:
# DB_NAME=algeria_wander
# DB_USER=root
# DB_PASSWORD=your_mysql_password
# DB_HOST=127.0.0.1
# DB_PORT=3306

# CORS — Frontend origins for local development.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500,http://localhost:5500

# Security Settings
SECURE_SSL_REDIRECT=False

# For Render production, see .env.render.example
