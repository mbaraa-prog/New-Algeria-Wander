# Render production environment example
# Copy to .env or configure these values in Render secret environment variables.

DJANGO_SECRET_KEY=your-production-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=algeria-wander-hods.onrender.com

# Database
DATABASE_URL=postgresql://user:password@host:5432/database_name

# Frontend origin for CORS
CORS_ALLOWED_ORIGINS=https://<your-frontend-domain>
CORS_ALLOW_CREDENTIALS=True

# Security
SECURE_SSL_REDIRECT=True

# Optional: if your frontend is deployed on a different domain, add it here too.
# CORS_ALLOWED_ORIGINS=https://your-frontend-domain,https://www.your-frontend-domain
