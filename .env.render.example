# Render production environment example
# Copy to .env or configure these values in Render secret environment variables.

DJANGO_SECRET_KEY=your-production-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=algeria-wander-hods.onrender.com,.onrender.com

# Database (auto-generated by Render)
DATABASE_URL=postgresql://user:password@host:5432/database_name

# Frontend origin for CORS
CORS_ALLOWED_ORIGINS=https://algeria-wander.vercel.app

# Security
SECURE_SSL_REDIRECT=True
